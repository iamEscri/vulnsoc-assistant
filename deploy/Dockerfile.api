FROM python:3.12-slim
WORKDIR /app
COPY backend/requirements.lock ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home app && mkdir /data && chown app:app /data
COPY modules ./modules
COPY backend ./backend
USER app
ENV STATE_DB=/data/state.sqlite3
EXPOSE 8000
CMD ["uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "172.29.0.2", "--limit-concurrency", "32"]
